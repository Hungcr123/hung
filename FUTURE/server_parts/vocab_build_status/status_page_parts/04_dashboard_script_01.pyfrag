          : wordAudioTotal > 0
            ? `QmDict UK/US audio ready: refreshed ${{wordAudioRefreshed}}/${{wordAudioTotal}} | failed ${{wordAudioFailed}}${{wordLastCopy}}`
            : scheduled
          ? "QmDict reloaded. Audio scan will start in the background."
          : repairRunning
