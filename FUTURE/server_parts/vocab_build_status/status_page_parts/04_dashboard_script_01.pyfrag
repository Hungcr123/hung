            : `Default: W ${{seconds}}s | P ${{paragraphSeconds}}s | chat ${{chatLimitMb}} MB | AI ${{payload.ai_agent_notice_voice || "kokoro:am_michael"}} | ${{speakState}} | ${{cpuState}} | ${{cfState}} | ${{obfState}}`;
