        renderQmDictStatus(payload.qmdict_reload || {{}}, payload.qmdict_audio_refresh || {{}}, payload.space_v_repair || {{}}, payload.qmdict_word_audio_refresh || {{}});
        if (!rewardSettingsGrid || !rewardSettingsGrid.contains(document.activeElement)) {{
