          const parts = line.split("|");
          const label = (parts.length > 1 ? parts.shift() : `Reaction ${{index + 1}}`).trim();
          const mark = parts.join("|").trim() || line;
          return {{ label, mark }};
        }})
    );
    const renderRewardSettings = (config = {{}}) => {{
