    .pill.is-busy .pulse,
    .pill.error .pulse {{
      animation: pulse 1.3s infinite;
    }}
    @keyframes pulse {{
      0% {{ box-shadow: 0 0 0 0 rgba(104, 243, 226, 0.42); }}
