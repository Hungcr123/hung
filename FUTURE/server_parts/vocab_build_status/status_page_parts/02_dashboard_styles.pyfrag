      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }}
    @keyframes adminPaintRemoteCursorPulse {{
      0%, 100% {{ opacity: 0.62; transform: scale(0.82) rotate(0deg); }}
      50% {{ opacity: 1; transform: scale(1.08) rotate(18deg); }}
    }}
    .admin-paint-text-editor {{
      position: absolute;
