        const previousStep = rows.length >= 2
          ? Math.max(25, Number(last.total_exp || 0) - Number(rows[rows.length - 2].total_exp || 0))
          : 25;
        rows.push({{ level: nextLevel, total_exp: Number(last.total_exp || 0) + previousStep }});
