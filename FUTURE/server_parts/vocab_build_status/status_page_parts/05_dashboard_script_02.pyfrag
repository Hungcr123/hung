      adminPaintPollInFlight = false;
    }};
    const startAdminPaintPolling = () => {{
      stopAdminPaintPolling();
      void pollAdminPaint({{ scheduleNext: true }});
    }};
    document.addEventListener("visibilitychange", () => {{
