    if path == "/vocab/leaderboard/npc-top/buff":
        try:
            session = self.auth_session()
            if not session:
                self.send_json(401, {"ok": False, "error": "Chua dang nhap."})
                return
            admin_username = normalize_username(session.get("username", ""))
